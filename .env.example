NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Supabase server credentials. Keep the service role key on the backend only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Gmail OAuth credentials. The worker stays disabled until all four values exist.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:4000/oauth2/callback
GMAIL_REFRESH_TOKEN=
GMAIL_SOURCE_EMAIL=ahmadrizal@gmail.com

POLL_INTERVAL_MS=10000
MESSAGE_RETENTION_DAYS=7
MAX_MESSAGES_PER_MAILBOX=20
