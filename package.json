{
  "name": "gmail-nator",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "backend:dev": "tsx watch server/src/main.ts",
    "backend:build": "tsc -p server/tsconfig.json",
    "backend:start": "node dist-server/main.js",
    "backend:typecheck": "tsc -p server/tsconfig.json --noEmit",
    "build": "next build",
    "build:all": "npm run build && npm run backend:build",
    "start": "next start",
    "typecheck": "tsc --noEmit && npm run backend:typecheck"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "express-rate-limit": "8.6.2",
    "googleapis": "176.0.0",
    "helmet": "8.3.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}
